#!/usr/bin/env zsh
# Author: Víctor Falcón Ruíz <hi@victorfalcon.es>
# License: MIT
# git-worktree-new.sh
# Manages git worktrees with subcommand dispatch.
#
# Usage:
#   git-worktree-new.sh <branch-name>          # create (default)
#   git-worktree-new.sh new <branch-name>       # create
#   git-worktree-new.sh new -c <branch-name>    # create in current tab
#   git-worktree-new.sh new --current <branch-name> # create in current tab
#   git-worktree-new.sh <branch-name> -c        # create in current tab
#   git-worktree-new.sh ls                      # list worktrees
#   git-worktree-new.sh del [-f] [branch-name]  # delete
#   git-worktree-new.sh delete [-f] [branch-name] # delete
#   git-worktree-new.sh help                    # show help

set -e

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

typeset -a WT_SETUP_SCRIPT_PATHS=(
  "worktree.sh"
  ".local-dev/scripts/setup-worktree.sh"
)

WT_DEFAULT_BRANCH="${WT_DEFAULT_BRANCH:-}"
WT_WORKTREES_DIR="${WT_WORKTREES_DIR:-}"
WT_SCRIPT_NAME="$(basename -- "$0")"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_wt_git_check() {
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not a git repository."
    exit 1
  fi
}

# Which terminal multiplexer are we inside? Echoes "zellij", "muxy", or "".
_wt_mux() {
  if [[ -n "${ZELLIJ:-}" ]]; then
    echo zellij
  elif [[ -n "${MUXY_PANE_ID:-}" ]]; then
    echo muxy
  fi
}

# muxy new-tab returns a *tab* id, but send/rename/close-pane need the *pane*
# id. Diff `list-panes` (tab-separated, id in column 1) around the call to find
# the newly created pane, and echo it.
# ponytail: assumes this is the only pane created in the interval — fine for interactive use.
_wt_muxy_new_pane() {
  local before after pane
  before="$(muxy list-panes 2>/dev/null | cut -f1 | sort)"
  muxy new-tab > /dev/null 2>&1 || return 1
  sleep 0.4
  after="$(muxy list-panes 2>/dev/null | cut -f1 | sort)"
  pane="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -1)"
  [[ -n "$pane" ]] || return 1
  printf '%s\n' "$pane"
}

# Open <cwd> in a new tab named <name>, then cd and optionally run <launch>.
_wt_open_tab() {
  local cwd="$1" name="$2" launch="${3:-}"
  local cd_cmd
  cd_cmd="cd -- $(printf '%q' "$cwd")"

  case "$(_wt_mux)" in
    zellij)
      zellij action new-tab --cwd "$cwd" --name "$name"
      sleep 0.3
      zellij action write-chars "$cd_cmd"
      zellij action write 10  # send Enter
      if [[ -n "$launch" ]]; then
        sleep 0.1
        zellij action write-chars "$launch"
        zellij action write 10  # send Enter
      fi
      ;;
    muxy)
      local pane
      pane="$(_wt_muxy_new_pane)" || {
        echo "Could not create a Muxy tab — navigate manually to: $cwd"
        return 1
      }
      muxy rename-pane --pane "$pane" "$name" > /dev/null 2>&1 || true
      muxy send --pane "$pane" "$cd_cmd"
      muxy send-keys --pane "$pane" Enter
      if [[ -n "$launch" ]]; then
        sleep 0.1
        muxy send --pane "$pane" "$launch"
        muxy send-keys --pane "$pane" Enter
      fi
      ;;
    *)
      echo "Not in a Zellij or Muxy session — navigate manually to: $cwd"
      return 1
      ;;
  esac
}

# Reuse the current tab/pane: prompt to rename, then cd and run <launch>.
_wt_use_current_tab() {
  local cwd="$1" name="$2" launch="$3"
  local cd_cmd ans=""
  cd_cmd="cd -- $(printf '%q' "$cwd")"

  case "$(_wt_mux)" in
    zellij)
      printf "Rename current Zellij tab to '%s'? [y/N] " "$name"
      read -r ans || true
      [[ "$ans" =~ ^[Yy]$ ]] && zellij action rename-tab "$name"
      zellij action write-chars "$cd_cmd"
      zellij action write 10  # send Enter
      sleep 0.1
      zellij action write-chars "$launch"
      zellij action write 10  # send Enter
      ;;
    muxy)
      printf "Rename current Muxy tab to '%s'? [y/N] " "$name"
      read -r ans || true
      [[ "$ans" =~ ^[Yy]$ ]] && muxy rename-pane --pane "$MUXY_PANE_ID" "$name" > /dev/null 2>&1
      muxy send --pane "$MUXY_PANE_ID" "$cd_cmd"
      muxy send-keys --pane "$MUXY_PANE_ID" Enter
      sleep 0.1
      muxy send --pane "$MUXY_PANE_ID" "$launch"
      muxy send-keys --pane "$MUXY_PANE_ID" Enter
      ;;
    *)
      echo "Not in a Zellij or Muxy session — navigate manually to: $cwd"
      return 1
      ;;
  esac
}

_wt_close_current_tab() {
  case "$(_wt_mux)" in
    zellij) zellij action close-tab ;;
    muxy)   muxy close-pane --pane "$MUXY_PANE_ID" ;;
  esac
}

_wt_prompt_close_tab() {
  local mux
  mux="$(_wt_mux)"
  [[ -n "$mux" ]] || return 0
  local label="Zellij"
  [[ "$mux" == muxy ]] && label="Muxy"
  printf "Close current %s tab? [Y/n] " "$label"
  local ans
  read -r ans || true
  if [[ -z "$ans" || "$ans" =~ ^[Yy]$ ]]; then
    _wt_close_current_tab
  fi
}

# Create (or reuse) the worktree via the Muxy CLI so it lands in Muxy's
# configured location (muxy.general.defaultWorktreeParentPath) and gets a tab.
# Echoes the worktree path. create-worktree output is tab-separated:
# "ok<TAB><id><TAB><name><TAB><path><TAB><branch>".
_wt_muxy_create_worktree() {
  local branch="$1" out existing default_branch
  existing="$(_wt_worktree_path_for_branch "$branch")"
  if [[ -n "$existing" ]]; then
    muxy switch-worktree "$branch" > /dev/null 2>&1 || true
    printf '%s\n' "$existing"
    return 0
  fi
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    out="$(muxy create-worktree "$branch" --existing 2>&1)"
  else
    default_branch="$(_wt_default_branch)"
    out="$(muxy create-worktree "$branch" --base "origin/$default_branch" 2>&1)"
    # --base origin/<default> leaves the branch tracking origin; drop it to
    # match the non-Muxy path (git worktree add --no-track).
    [[ "$out" == ok* ]] && git branch --unset-upstream "$branch" 2>/dev/null || true
  fi
  if [[ "$out" != ok* ]]; then
    echo "muxy create-worktree failed: $out" >&2
    return 1
  fi
  printf '%s' "$out" | cut -f4
}

# Echo the id of the Muxy pane whose cwd is <target> (the tab create-worktree
# opened). Retries since the tab appears asynchronously.
# NB: never name a local "path" in zsh — it is tied to $PATH.
_wt_muxy_pane_for_path() {
  local target="$1" pane i
  for i in {1..10}; do
    pane="$(muxy list-panes 2>/dev/null | awk -F'\t' -v p="$target" '$3==p {print $1; exit}')"
    [[ -n "$pane" ]] && { printf '%s\n' "$pane"; return 0; }
    sleep 0.2
  done
  return 1
}

# Focus <pane>'s worktree so its terminal surface renders (muxy send only
# reaches a visible pane), wait until it is ready, then run <launch>.
# Muxy already names the tab after the worktree, so we don't rename it.
_wt_muxy_run_in_pane() {
  local pane="$1" launch="$2" branch="$3" i
  [[ -n "$branch" ]] && muxy switch-worktree "$branch" > /dev/null 2>&1 || true
  for i in {1..25}; do
    muxy read-screen --pane "$pane" --lines 1 > /dev/null 2>&1 && break
    sleep 0.2
  done
  muxy send --pane "$pane" "$launch"
  muxy send-keys --pane "$pane" Enter
}

_wt_usage() {
  cat <<EOF
Usage:
  $WT_SCRIPT_NAME <branch-name>
  $WT_SCRIPT_NAME new [-c|--current|--current-tab] <branch-name>
  $WT_SCRIPT_NAME <branch-name> [-c|--current|--current-tab]
  $WT_SCRIPT_NAME ls
  $WT_SCRIPT_NAME del [-f|--force] [branch-name]
  $WT_SCRIPT_NAME delete [-f|--force] [branch-name]
  $WT_SCRIPT_NAME help

Options:
  -c, --current, --current-tab
                     Reuse the current tab instead of opening a new one.
  -f, --force        Skip prompts when deleting: force-remove the worktree
                     and delete the branch. Always prompts before closing
                     the current tab (default Yes).

Config:
  WT_DEFAULT_BRANCH  Override the branch used for merged checks.
  WT_WORKTREES_DIR   Override the parent directory where worktrees are stored.

Behavior (new):
  - Under Zellij (or no multiplexer): creates worktrees under
    WT_WORKTREES_DIR/<repo-name>/<branch-name>, defaulting WT_WORKTREES_DIR to
    ../worktrees next to the repo root, and opens a new Zellij tab
  - Under Muxy: delegates to `muxy create-worktree`, so the worktree lands in
    Muxy's configured location (muxy.general.defaultWorktreeParentPath) and
    opens in a Muxy tab; WT_WORKTREES_DIR and -c/--current are ignored
  - With -c/--current/--current-tab (Zellij only), reuses the current tab and
    asks before renaming it

Behavior (ls):
  - Lists all worktrees for the current repository (excluding the main working tree)
  - Shows branch name, short commit hash, and path for each worktree

Behavior (del):
  - Removes the worktree for the given branch (or the current branch if omitted)
  - Prompts to force-remove if the worktree has uncommitted changes, unless -f/--force is set
  - Asks whether to delete the local branch after worktree removal
    - Merged branches default to Yes [Y/n], unmerged default to No [y/N]
  - With -f/--force, also deletes the branch without asking
  - Under Muxy, runs `muxy refresh-worktrees` after removal (Muxy has no
    delete-worktree command) so its worktree list stays in sync
  - When running inside Zellij or Muxy, always prompts before closing the current tab (default Yes: Enter or y closes, n keeps)
EOF
}

_wt_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

_wt_common_root() {
  local common_dir

  common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [[ -n "$common_dir" ]] || return 1

  dirname -- "$common_dir"
}

_wt_default_branch() {
  local branch

  if [[ -n "$WT_DEFAULT_BRANCH" ]]; then
    echo "$WT_DEFAULT_BRANCH"
    return 0
  fi

  branch="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')"
  if [[ -z "$branch" ]]; then
    branch="$(git branch -r --format='%(refname:short)' 2>/dev/null | grep -E '/(main|master|trunk|develop)$' | head -1 | sed 's@.*/@@')"
  fi
  if [[ -z "$branch" ]]; then
    branch="$(git branch --format='%(refname:short)' 2>/dev/null | grep -E '^(main|master|trunk|develop)$' | head -1)"
  fi
  echo "${branch:-main}"
}

_wt_merge_check_ref() {
  local default_branch="$1"
  local remote_ref="refs/remotes/origin/$default_branch"

  if git remote get-url origin > /dev/null 2>&1; then
    git fetch --quiet origin "$default_branch" > /dev/null 2>&1 || true
  fi

  if git show-ref --verify --quiet "$remote_ref"; then
    echo "origin/$default_branch"
    return 0
  fi

  echo "$default_branch"
}

# Returns 0 if the branch is fully merged (regular or squash) into default branch.
_wt_is_merged() {
  local branch="$1" default_branch="$2"

  # Regular merge: branch tip is an ancestor of default branch
  if git merge-base --is-ancestor "$branch" "$default_branch" 2>/dev/null; then
    return 0
  fi

  # Squash merge detection via commit-tree + git-cherry:
  # Create a hypothetical single commit that represents the cumulative diff of the
  # branch over the merge-base, then check if an equivalent patch already exists in
  # the default branch.
  local merge_base test_commit cherry_result
  merge_base="$(git merge-base "$default_branch" "$branch" 2>/dev/null)" || return 1
  [[ -z "$merge_base" ]] && return 1

  test_commit="$(git commit-tree "${branch}^{tree}" -p "$merge_base" -m "__wt_squash_test__" 2>/dev/null)" || return 1
  [[ -z "$test_commit" ]] && return 1

  cherry_result="$(git cherry "$default_branch" "$test_commit" 2>/dev/null)" || return 1

  # "- <hash>" means an equivalent patch was found in default_branch (squash merged).
  # Empty result means the branch introduced no changes (already up-to-date).
  if [[ "$cherry_result" == "- "* ]] || [[ -z "$cherry_result" ]]; then
    return 0
  fi

  return 1
}

_wt_worktree_exists() {
  local target_path="$1" line current_path=""

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      current_path="${line#worktree }"
      if [[ "$current_path" == "$target_path" ]]; then
        return 0
      fi
    fi
  done < <(git worktree list --porcelain)

  return 1
}

_wt_worktree_path_for_branch() {
  local branch_ref="refs/heads/$1" line current_path=""

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      current_path="${line#worktree }"
    elif [[ "$line" == "branch $branch_ref" ]]; then
      printf '%s\n' "$current_path"
      return 0
    fi
  done < <(git worktree list --porcelain)

  return 1
}

# ---------------------------------------------------------------------------
# List worktrees
# ---------------------------------------------------------------------------

_wt_open_existing_tab() {
  local worktree_path="$1" branch_name="$2"
  _wt_open_tab "$worktree_path" "󰔱 $branch_name" ""
}

_wt_list() {
  _wt_git_check

  local main_worktree line current_path="" current_branch="" current_head=""
  local is_bare=false count=0
  local -a paths branches heads

  main_worktree="$(_wt_repo_root)"

  _wt_list_flush() {
    # Skip the main worktree and bare entries
    if [[ -n "$current_path" && "$current_path" != "$main_worktree" ]] && ! $is_bare; then
      paths+=("$current_path")
      branches+=("${current_branch:-(detached)}")
      heads+=("${current_head:-unknown}")
    fi
  }

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      _wt_list_flush
      current_path="${line#worktree }"
      current_branch=""
      current_head=""
      is_bare=false
    elif [[ "$line" == branch\ * ]]; then
      current_branch="${line#branch refs/heads/}"
    elif [[ "$line" == HEAD\ * ]]; then
      current_head="${line#HEAD }"
    elif [[ "$line" == "bare" ]]; then
      is_bare=true
    fi
  done < <(git worktree list --porcelain)

  # Flush the last entry
  _wt_list_flush
  unfunction _wt_list_flush

  if (( ${#paths[@]} == 0 )); then
    echo "No worktrees found (other than the main working tree)."
    return 0
  fi

  # Interactive picker via fzf when available and on a TTY
  if [[ -t 0 && -t 1 ]] && command -v fzf > /dev/null 2>&1; then
    local i fzf_input="" selection selected_path selected_branch
    for (( i = 1; i <= ${#paths[@]}; i++ )); do
      local short_head="${heads[$i]:0:8}"
      fzf_input+="${branches[$i]}\t${short_head}\t${paths[$i]}\n"
    done

    selection="$(printf "$fzf_input" | fzf \
      --delimiter='\t' \
      --with-nth=1,2,3 \
      --prompt="worktree> " \
      --header="Pick a worktree to open in a new tab" \
      --height=40% \
      --reverse \
      --ansi)" || return 0

    [[ -z "$selection" ]] && return 0

    selected_branch="${selection%%$'\t'*}"
    selected_path="${selection##*$'\t'}"
    _wt_open_existing_tab "$selected_path" "$selected_branch"
    return 0
  fi

  echo ""
  echo "  Worktrees for $(basename "$main_worktree"):"
  echo ""

  local i
  for (( i = 1; i <= ${#paths[@]}; i++ )); do
    local short_head="${heads[$i]:0:8}"
    echo "  ${branches[$i]}  ${short_head}  ${paths[$i]}"
  done

  echo ""
  echo "  ${#paths[@]} worktree(s)"
  echo ""
}

# ---------------------------------------------------------------------------
# Create worktree
# ---------------------------------------------------------------------------

_wt_new() {
  local CURRENT_TAB=false
  local BRANCH_NAME=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--current|--current-tab)
        CURRENT_TAB=true
        shift
        ;;
      -*)
        echo "Error: unknown option '$1'."
        echo "Usage: $WT_SCRIPT_NAME [new] [-c|--current|--current-tab] <branch-name>"
        exit 1
        ;;
      *)
        if [[ -n "$BRANCH_NAME" ]]; then
          echo "Error: unexpected argument '$1'."
          echo "Usage: $WT_SCRIPT_NAME [new] [-c|--current|--current-tab] <branch-name>"
          exit 1
        fi
        BRANCH_NAME="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$BRANCH_NAME" ]]; then
    echo "Error: branch name is required."
    echo "Usage: $WT_SCRIPT_NAME [new] [-c|--current|--current-tab] <branch-name>"
    exit 1
  fi

  _wt_git_check

  local mux ORIGIN_DIR FOLDER_NAME WORKTREE_PATH="" TARGET_PANE=""
  mux="$(_wt_mux)"
  ORIGIN_DIR="$(_wt_repo_root)"
  FOLDER_NAME="$(basename "$ORIGIN_DIR")"

  if [[ "$mux" == muxy ]]; then
    # Delegate creation to Muxy so the worktree lands in its configured
    # location and opens in a Muxy tab. -c/--current has no effect here.
    git fetch origin 2>/dev/null || echo "Warning: could not fetch from origin"
    WORKTREE_PATH="$(_wt_muxy_create_worktree "$BRANCH_NAME")" || exit 1
    TARGET_PANE="$(_wt_muxy_pane_for_path "$WORKTREE_PATH")" || true
  else
    local WORKTREE_ROOT
    WORKTREE_ROOT="${WT_WORKTREES_DIR:-$(dirname "$ORIGIN_DIR")/worktrees}"
    WORKTREE_PATH="$WORKTREE_ROOT/$FOLDER_NAME/$BRANCH_NAME"

    mkdir -p "$(dirname "$WORKTREE_PATH")"

    git fetch origin 2>/dev/null || echo "Warning: could not fetch from origin"

    if _wt_worktree_exists "$WORKTREE_PATH"; then
      echo "Worktree already exists at $WORKTREE_PATH — opening tab."
    elif [[ -e "$WORKTREE_PATH" ]]; then
      echo "Error: path already exists but is not a registered worktree: $WORKTREE_PATH"
      exit 1
    elif git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
      git worktree add "$WORKTREE_PATH" "$BRANCH_NAME" 2>&1
    else
      local DEFAULT_BRANCH
      DEFAULT_BRANCH="$(_wt_default_branch)"
      git worktree add -b "$BRANCH_NAME" --no-track "$WORKTREE_PATH" "origin/$DEFAULT_BRANCH" 2>&1
    fi

    # Bail out gracefully when not inside a supported multiplexer session
    if [[ -z "$mux" ]]; then
      echo "Not in a Zellij or Muxy session — navigate manually to: $WORKTREE_PATH"
      exit 0
    fi
  fi

  # Personal per-repo override, looked up by repo folder name under
  # ~/.config/worktree-setup/<repo>.sh. Lives outside the repo, so it is never
  # tracked and is reachable from a fresh worktree. Takes priority over the
  # in-repo scripts. Override the dir with WT_PERSONAL_SETUP_DIR.
  local SETUP_SCRIPT=""
  local personal_setup="${WT_PERSONAL_SETUP_DIR:-$HOME/.config/worktree-setup}/$FOLDER_NAME.sh"
  if [[ -f "$personal_setup" ]]; then
    SETUP_SCRIPT="$personal_setup"
  fi

  # Otherwise pick a setup script if one exists in the origin repo
  local relative_setup_script
  if [[ -z "$SETUP_SCRIPT" ]]; then
    for relative_setup_script in "${WT_SETUP_SCRIPT_PATHS[@]}"; do
      if [[ -f "$ORIGIN_DIR/$relative_setup_script" ]]; then
        SETUP_SCRIPT="$WORKTREE_PATH/$relative_setup_script"
        break
      fi
    done
  fi

  # Write a self-deleting temp script the multiplexer will run in the new tab.
  local TMPSCRIPT LAUNCH_COMMAND
  TMPSCRIPT="$(mktemp "${TMPDIR:-/tmp}/wt-setup.XXXXXX")"
  cat > "$TMPSCRIPT" <<'EOF'
#!/usr/bin/env zsh

TMPSCRIPT="$1"
WORKTREE_PATH="$2"
BRANCH_NAME="$3"
SETUP_SCRIPT="$4"
ORIGIN_DIR="$5"

rm -f -- "$TMPSCRIPT"
cd -- "$WORKTREE_PATH"

echo ""
echo "  Worktree : $WORKTREE_PATH"
echo "  Branch   : $BRANCH_NAME"

if [[ -n "$SETUP_SCRIPT" ]]; then
  echo "  Setup    : running $(basename "$SETUP_SCRIPT")"
  echo ""
  if [[ ! -x "$SETUP_SCRIPT" ]]; then
    if [[ -w "$SETUP_SCRIPT" ]]; then
      chmod +x "$SETUP_SCRIPT"
    else
      echo "Setup script is not executable. Password required to fix permissions."
      sudo -v
      sudo chmod +x "$SETUP_SCRIPT"
    fi
  fi
  "$SETUP_SCRIPT" "$ORIGIN_DIR"
else
  echo "  Setup    : no worktree script found, skipping."
  echo ""
fi

exec "${SHELL:-/bin/zsh}"
EOF
  chmod +x "$TMPSCRIPT"

  LAUNCH_COMMAND="$(printf '%q ' "$TMPSCRIPT" "$TMPSCRIPT" "$WORKTREE_PATH" "$BRANCH_NAME" "$SETUP_SCRIPT" "$ORIGIN_DIR")"
  LAUNCH_COMMAND="${LAUNCH_COMMAND% }"

  if [[ "$mux" == muxy ]]; then
    # Muxy already opened the tab in the new worktree; just run setup in it.
    if [[ -n "$TARGET_PANE" ]]; then
      _wt_muxy_run_in_pane "$TARGET_PANE" "$LAUNCH_COMMAND" "$BRANCH_NAME"
    else
      echo "Worktree ready at $WORKTREE_PATH — could not locate its Muxy pane to run setup."
    fi
  elif $CURRENT_TAB; then
    _wt_use_current_tab "$WORKTREE_PATH" "󰔱 $BRANCH_NAME" "$LAUNCH_COMMAND"
  else
    _wt_open_tab "$WORKTREE_PATH" "󰔱 $BRANCH_NAME" "$LAUNCH_COMMAND"
  fi
}

# ---------------------------------------------------------------------------
# Delete worktree
# ---------------------------------------------------------------------------

_wt_delete() {
  local FORCE=false
  local BRANCH_NAME=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force)
        FORCE=true
        shift
        ;;
      -*)
        echo "Error: unknown option '$1'."
        echo "Usage: $WT_SCRIPT_NAME del [-f|--force] [branch-name]"
        exit 1
        ;;
      *)
        if [[ -n "$BRANCH_NAME" ]]; then
          echo "Error: unexpected argument '$1'."
          echo "Usage: $WT_SCRIPT_NAME del [-f|--force] [branch-name]"
          exit 1
        fi
        BRANCH_NAME="$1"
        shift
        ;;
    esac
  done

  _wt_git_check

  # If no branch name given, try to detect from current location
  if [[ -z "$BRANCH_NAME" ]]; then
    BRANCH_NAME="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || true
    if [[ -z "$BRANCH_NAME" || "$BRANCH_NAME" == "HEAD" ]]; then
      echo "Error: branch name is required."
      echo "Usage: $WT_SCRIPT_NAME del [-f|--force] [branch-name]"
      exit 1
    fi
    echo "Detected branch: $BRANCH_NAME"
  fi

  # Find the registered worktree for this branch
  local WORKTREE_PATH
  WORKTREE_PATH="$(_wt_worktree_path_for_branch "$BRANCH_NAME")"

  if [[ -z "$WORKTREE_PATH" ]]; then
    echo "Error: no worktree found for branch '$BRANCH_NAME'."
    exit 1
  fi

  local CURRENT_PWD SAFE_REPO_ROOT
  CURRENT_PWD="$(pwd -P 2>/dev/null || pwd)"
  SAFE_REPO_ROOT="$(_wt_common_root)"

  if [[ -n "$SAFE_REPO_ROOT" ]] && [[ "$CURRENT_PWD" == "$WORKTREE_PATH" || "$CURRENT_PWD" == "$WORKTREE_PATH"/* ]]; then
    cd -- "$SAFE_REPO_ROOT"
  fi

  # Remove the worktree directory
  echo "Removing worktree at $WORKTREE_PATH ..."
  if $FORCE; then
    git worktree remove --force "$WORKTREE_PATH"
  elif ! git worktree remove "$WORKTREE_PATH" 2>/dev/null; then
    printf "Worktree has uncommitted changes. Force remove? [y/N] "
    local ans
    read -r ans || true
    if [[ "$ans" =~ ^[Yy]$ ]]; then
      git worktree remove --force "$WORKTREE_PATH"
    else
      echo "Aborted."
      exit 1
    fi
  fi

  # Muxy has no delete-worktree command; sync its list after the git removal.
  [[ "$(_wt_mux)" == muxy ]] && muxy refresh-worktrees > /dev/null 2>&1 || true

  # Check if the local branch still exists
  if ! git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
    echo "Branch '$BRANCH_NAME' no longer exists locally. Done."
    _wt_prompt_close_tab
    return 0
  fi

  if $FORCE; then
    git branch -D "$BRANCH_NAME"
    echo "Branch deleted."
    _wt_prompt_close_tab
    return 0
  fi

  local DEFAULT_BRANCH MERGE_CHECK_REF
  DEFAULT_BRANCH="$(_wt_default_branch)"
  MERGE_CHECK_REF="$(_wt_merge_check_ref "$DEFAULT_BRANCH")"

  local is_merged=false
  if _wt_is_merged "$BRANCH_NAME" "$MERGE_CHECK_REF"; then
    is_merged=true
  fi

  echo ""
  if $is_merged; then
    echo "Branch '$BRANCH_NAME' is merged into '$MERGE_CHECK_REF'."
    printf "Delete the branch? [Y/n] "
  else
    echo "Branch '$BRANCH_NAME' has not been merged into '$MERGE_CHECK_REF'."
    printf "Delete the branch anyway? [y/N] "
  fi

  local answer
  read -r answer || true

  if $is_merged; then
    # Default is Yes for merged branches
    if [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]; then
      git branch -d "$BRANCH_NAME"
      echo "Branch deleted."
    else
      echo "Branch kept."
    fi
  else
    # Default is No for unmerged branches
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      git branch -D "$BRANCH_NAME"
      echo "Branch deleted."
    else
      echo "Branch kept."
    fi
  fi

  # Offer to close the current tab
  _wt_prompt_close_tab
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "$1" in
  help|-h|--help)
    _wt_usage
    ;;
  ls|list)
    shift
    _wt_list "$@"
    ;;
  del|delete)
    shift
    _wt_delete "$@"
    ;;
  new)
    shift
    _wt_new "$@"
    ;;
  *)
    # Default: treat first arg as branch name for create
    _wt_new "$@"
    ;;
esac
